 "mapDockOpen": "<div class=\"map-dock menu-open\" id=\"controls\">\n    <!-- Скрытые входы (v=228): «?» — справка (шторка жмёт его, onHelp в js/planshet.js); 🏷️ «меньше подписей» и\n         ▦ планшет/граф — одна кнопка в шторке «Феном ▴» (#menuLabels на карте / #menuGraph в нодах), логика — на этих\n         кнопках в js/map.js. На панели их больше нет (владелец 02.11: панель — только для главного). -->\n    <button id=\"helpBtn\" hidden=\"\" aria-label=\"Как пользоваться картой\"></button>\n    <button id=\"labelsToggle\" hidden=\"\" aria-label=\"Меньше подписей\" class=\"active\"></button>\n    <button id=\"sortToggle\" hidden=\"\" aria-label=\"Граф связей\" title=\"Граф связей\"></button>\n    <div class=\"dock-bar\">\n      <!-- Одна панель во всех режимах (v=227–229; владелец): слева плашка «Феном ▴» (шторка: схема корабля, разделы,\n           сюжет, вид, помощь) и 🔍 (поиск по Феному, и на карте); справа отдельной плашкой — все три режима, и в «Нодах». -->\n      <div class=\"dock-planshet\" id=\"dockPlanshet\">\n        <button id=\"planshetBrand\" class=\"dock-brand pulse\" aria-haspopup=\"dialog\" aria-expanded=\"true\" title=\"Схема корабля, разделы, сюжет, помощь\" aria-controls=\"planshetMenu\">\n          <span class=\"dock-brand-name\">Феном</span>\n        </button>\n        <button id=\"planshetSearch\" class=\"dock-tool\" title=\"Поиск\" aria-label=\"Поиск\"><svg class=\"dock-svg\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"M15.5 15.5 21 21\"></path></svg></button>\n      </div>\n      <!-- Переключатель режима (как слои на обычных картах), setViewMode в\n           js/map.js: «Ноды» — граф связей без карты, «Карта» — с политической\n           раскраской StellarMaps, «Графика» — та же карта без неё. Подсветка\n           активного — «линза» .view-lens, её двигает updateViewModeUi. -->\n      <div class=\"dock-modes\" id=\"viewSwitch\" role=\"group\" aria-label=\"Режим просмотра карты\">\n        <span class=\"view-lens ready\" aria-hidden=\"true\" style=\"width: 70px; transform: translateX(74px);\"></span>\n        <button class=\"view-switch-btn dock-item\" data-view=\"nodes\" aria-label=\"Ноды\" title=\"Граф связей: все точки и их связи, без самой карты\" aria-pressed=\"false\">\n          <svg class=\"dock-svg\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 7.6l8-1.2M6.8 10.1l3.9 6.3M17.3 8.2l-4.1 8.1\"></path><circle cx=\"5.5\" cy=\"8\" r=\"2.5\"></circle><circle cx=\"18.5\" cy=\"6\" r=\"2.5\"></circle><circle cx=\"12\" cy=\"18.5\" r=\"2.5\"></circle></svg>\n          <span class=\"dock-label\">Ноды</span>\n        </button>\n        <button class=\"view-switch-btn dock-item active\" data-view=\"map\" aria-label=\"Карта\" title=\"Карта галактики\" aria-pressed=\"true\">\n          <svg class=\"dock-svg\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.5 6.5 9 4.5l6 2 5.5-2v13l-5.5 2-6-2-5.5 2z\"></path><path d=\"M9 4.5v13M15 6.5v13\"></path></svg>\n          <span class=\"dock-label\">Карта</span>\n        </button>\n        <button class=\"view-switch-btn dock-item\" data-view=\"graphics\" aria-label=\"Графика\" title=\"Карта без политической раскраски — только фон, гиперлейны и названия систем\" aria-pressed=\"false\">\n          <svg class=\"dock-svg\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 12a1.5 1.5 0 0 1 3 0 3 3 0 0 1-6 0 4.5 4.5 0 0 1 9 0 6 6 0 0 1-12 0\"></path><circle class=\"dock-svg-dot\" cx=\"19.6\" cy=\"5.4\" r=\"1\"></circle><circle class=\"dock-svg-dot\" cx=\"4.6\" cy=\"18.8\" r=\"0.8\"></circle></svg>\n          <span class=\"dock-label\">Графика</span>\n        </button>\n      </div>\n      <!-- «Справочник» убран 02.11.2026 (владелец): статьи — в библиотеке планшета (Ноды → ▦)\n           и в «Материалах» окон точек. -->\n    </div>\n  </div>",
 "storyDock": "<div class=\"node-dock dock-snap\">\n      <div class=\"node-links\" id=\"phenomLinks\" style=\"--p: 0.0000;\"><div class=\"node-strip\"><button type=\"button\" class=\"node-crumb\" title=\"Место: Феном\"><span class=\"node-marker shape-hexagon kind-world node-strip-marker\" style=\"border-color: rgb(255, 255, 255);\"><img alt=\"\" src=\"images/markers/logophenome.webp\"></span><span class=\"node-crumb-name\">Феном</span><span class=\"node-crumb-sep\" aria-hidden=\"true\">›</span></button><button type=\"button\" class=\"node-strip-open\" title=\"Все переходы — нажми или потяни\" aria-expanded=\"false\"><span class=\"node-strip-title\">Переворот</span><span class=\"node-stack\" title=\"Персонажи: 9\"><span class=\"node-marker shape-square kind-character node-stack-face\" style=\"border-color: rgb(175, 238, 238); z-index: 3;\"><img alt=\"\" src=\"images/naito.jpg\"></span><span class=\"node-marker shape-square kind-character node-stack-face\" style=\"border-color: rgb(175, 238, 238); z-index: 2;\"><img alt=\"\" src=\"images/characters/ket-uollen.jpg?v=1789493214\"></span><span class=\"node-marker shape-square kind-character node-stack-face\" style=\"border-color: rgb(175, 238, 238); z-index: 1;\"><img alt=\"\" src=\"images/markers/fox.webp\"></span><span class=\"node-stack-n\">9</span></span><span class=\"node-strip-chev\"><svg viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"M2.5 7.5 6 4l3.5 3.5\"></path></svg></span></button></div><div class=\"node-links-body\" style=\"height: 0px;\"><div class=\"node-links-cols\"><div class=\"node-links-col is-chars\"><span class=\"link-group\"><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Найто Афетович\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); --dx: 193.0; --dy: -48.0; --s: 0.733; --o0: 1;\"><img alt=\"\" src=\"images/naito.jpg\"></span></span><span class=\"link-chip-caption\">Найто</span></button><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Кэт Уоллен\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); --dx: 152.0; --dy: -48.0; --s: 0.733; --o0: 1;\"><img alt=\"\" src=\"images/characters/ket-uollen.jpg?v=1789493214\"></span></span><span class=\"link-chip-caption\">Кэт</span></button><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Фокс\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); --dx: 111.0; --dy: -48.0; --s: 0.733; --o0: 1;\"><img alt=\"\" src=\"images/markers/fox.webp\"></span></span><span class=\"link-chip-caption\">Фокс</span></button></span><span class=\"link-group\"><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Сорэн Расский\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); --dx: 43.0; --dy: -48.0; --s: 0.733; --o0: 0;\"><img alt=\"\" src=\"images/markers/soren.webp\"></span></span><span class=\"link-chip-caption\">Сорэн</span></button><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Стил\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); --dx: -13.0; --dy: -48.0; --s: 0.733; --o0: 0;\"><img alt=\"\" src=\"images/markers/stil.webp\"></span></span><span class=\"link-chip-caption\">Стил</span></button></span><span class=\"link-group\"><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Пауль Лангерганс\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); --dx: 223.0; --dy: -106.0; --s: 0.733; --o0: 0;\"><img alt=\"\" src=\"images/markers/paul.webp\"></span></span><span class=\"link-chip-caption\">Пауль</span></button><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Теодор Драйзер\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); background: rgba(175, 238, 238, 0.92); --dx: 167.0; --dy: -106.0; --s: 0.733; --o0: 0;\">Т</span></span><span class=\"link-chip-caption\">Теодор</span></button></span><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Райден Аматеру\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); --dx: 104.0; --dy: -106.0; --s: 0.733; --o0: 0;\"><img alt=\"\" src=\"images/markers/rain.webp\"></span></span><span class=\"link-chip-caption\">Райден</span></button><button type=\"button\" class=\"link-chip link-chip--char\" title=\"Шелди У'окер\"><span class=\"link-chip-slot\"><span class=\"node-marker shape-square kind-character link-chip-marker\" style=\"border-color: rgb(175, 238, 238); --dx: 46.0; --dy: -106.0; --s: 0.733; --o0: 0;\"><img alt=\"\" src=\"images/markers/shell.webp\"></span></span><span class=\"link-chip-caption\">Шелди</span></button></div></div></div></div>\n      <div class=\"phenom-toolbar lore-toolbar tabbar\" id=\"phenomToolbar\">\n      <button class=\"toolbar-close-btn\" id=\"phenomClose\" aria-label=\"Закрыть\">✕</button>\n      <!-- Тело окна — две вкладки: «Описание» (базовая, подсвечена при\n           открытии) и «Статья» (только если у точки есть ссылка на статью),\n           applyNodeToolbar/showNodeBody в js/node-window.js. -->\n      <button class=\"tabbar-btn active\" id=\"phenomDescriptionTab\" aria-pressed=\"true\">\n        <span class=\"tabbar-btn-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 6.5h14M5 10.5h11M5 14.5h14M5 18.5h8\"></path></svg></span><span class=\"tabbar-btn-label\">Описание</span>\n      </button>\n      <button class=\"tabbar-btn\" id=\"phenomArticleTab\" style=\"display:none\" aria-pressed=\"false\" title=\"Статья\">\n        <span class=\"tabbar-btn-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 6.8C10 5.3 7 4.8 4 5.3v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13c-3-.5-6 0-8 1.5z\"></path><path d=\"M12 6.8v13\"></path></svg></span><span class=\"tabbar-btn-label\">Статья</span>\n      </button>\n      <!-- «Игра» — состав ветки (v=177), только если в ней есть персонажи\n           (renderGame в js/node-window.js). -->\n      <button class=\"tabbar-btn\" id=\"phenomGameTab\" style=\"\" aria-pressed=\"false\">\n        <span class=\"tabbar-btn-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"6.5\" r=\"2.6\"></circle><path d=\"M9.8 10.6h4.4l1 5.4H8.8z\"></path><path d=\"M6.5 20h11l-1-4H7.5z\"></path></svg></span><span class=\"tabbar-btn-label\">Игра</span>\n      </button>\n      <!-- Своя карта точки (поле submap, сейчас у Фенома) — схема корабля\n           ship/ во фрейме, вкладкой (openSubmapView в js/phenom.js). -->\n      <button class=\"tabbar-btn\" id=\"phenomMapTab\" hidden=\"\" aria-pressed=\"false\">\n        <span class=\"tabbar-btn-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M3.5 6.5 9 4.5l6 2 5.5-2v13l-5.5 2-6-2-5.5 2z\"></path><path d=\"M9 4.5v13M15 6.5v13\"></path></svg></span><span class=\"tabbar-btn-label\">Карта</span>\n      </button>\n      <!-- Только владелец группы, карта из лички бота — showNodeEditor в js/editor.js. -->\n      <button class=\"tabbar-btn\" id=\"phenomEdit\" hidden=\"\" aria-pressed=\"false\">\n        <span class=\"tabbar-btn-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M4.5 19.5l1-4.4L15.6 5a2.1 2.1 0 0 1 3 0l.4.4a2.1 2.1 0 0 1 0 3L8.9 18.5z\"></path><path d=\"M13.6 7l3.4 3.4\"></path></svg></span><span class=\"tabbar-btn-label\">Правка</span>\n      </button>\n    </div>\n    </div>",
